# Modelo das variaveis de ambiente do Elo Escolar.
# Copie este arquivo para .env e preencha os valores.
# O .env nunca vai para o GitHub (ver .gitignore).

# Chave com que o Django assina a sessao, o token de redefinicao de
# senha e a protecao CSRF. Gere uma nova com:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# True apenas na maquina de desenvolvimento. Em producao, sempre False.
DEBUG=True

# Chave da API do Brevo, usada para avisar o responsavel quando o
# pedido de acesso e aprovado ou recusado. Fica no painel do Brevo.
BREVO_API_KEY=

# Endereco de e-mail remetente, cadastrado e verificado no Brevo.
EMAIL_REMETENTE=
